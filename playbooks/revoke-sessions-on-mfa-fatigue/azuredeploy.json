{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "title": "Revoke sessions on MFA fatigue",
    "description": "Respuesta automatizada a la deteccion 'Inicio de sesion exitoso tras una rafaga de MFA denegados'. Revoca los tokens de sesion del usuario afectado y deja constancia en el incidente. NO deshabilita la cuenta: ver el README de esta carpeta para el porque.",
    "prerequisites": "Sentinel habilitado. La identidad administrada del Logic App necesita el permiso de aplicacion User.ReadWrite.All en Microsoft Graph, otorgado por un administrador.",
    "lastUpdateTime": "2026-08-29",
    "releaseNotes": "1.0.0 - version inicial"
  },
  "parameters": {
    "PlaybookName": {
      "type": "string",
      "defaultValue": "revoke-sessions-on-mfa-fatigue",
      "metadata": { "description": "Nombre del Logic App." }
    }
  },
  "variables": {
    "AzureSentinelConnectionName": "[concat('azuresentinel-', parameters('PlaybookName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[variables('AzureSentinelConnectionName')]",
      "location": "[resourceGroup().location]",
      "kind": "V1",
      "properties": {
        "displayName": "[variables('AzureSentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2017-07-01",
      "name": "[parameters('PlaybookName')]",
      "location": "[resourceGroup().location]",
      "identity": { "type": "SystemAssigned" },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "defaultValue": {}, "type": "Object" }
          },
          "triggers": {
            "Microsoft_Sentinel_incident": {
              "type": "ApiConnectionWebhook",
              "inputs": {
                "body": {
                  "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                  }
                },
                "path": "/incident-creation"
              }
            }
          },
          "actions": {
            "Obtener_la_cuenta_afectada": {
              "runAfter": {},
              "type": "Compose",
              "description": "Toma la primera entidad de tipo Account del incidente. Si el incidente no trae cuenta, las acciones siguientes no corren y el incidente queda anotado.",
              "inputs": "@first(body('Microsoft_Sentinel_incident')?['object']?['properties']?['relatedEntities'])"
            },
            "Hay_una_cuenta": {
              "runAfter": { "Obtener_la_cuenta_afectada": ["Succeeded"] },
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@outputs('Obtener_la_cuenta_afectada')?['properties']?['aadUserId']",
                        "@null"
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Ver_si_la_cuenta_es_privilegiada": {
                  "runAfter": {},
                  "type": "Http",
                  "description": "GUARD ANTIARMA. Si la cuenta tiene roles de directorio asignados, el playbook NO actua solo: escala. Un atacante podria disparar la deteccion a proposito contra un administrador para provocar una denegacion de servicio usando nuestra propia automatizacion.",
                  "inputs": {
                    "method": "GET",
                    "uri": "https://graph.microsoft.com/v1.0/users/@{outputs('Obtener_la_cuenta_afectada')?['properties']?['aadUserId']}/transitiveMemberOf/microsoft.graph.directoryRole",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "https://graph.microsoft.com"
                    }
                  }
                },
                "Decidir_segun_privilegio": {
                  "runAfter": { "Ver_si_la_cuenta_es_privilegiada": ["Succeeded"] },
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@length(body('Ver_si_la_cuenta_es_privilegiada')?['value'])",
                          0
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Revocar_sesiones": {
                      "runAfter": {},
                      "type": "Http",
                      "description": "Invalida todos los tokens de actualizacion del usuario. Es la accion correcta aqui: el atacante pierde la sesion robada y el usuario legitimo solo tiene que volver a iniciar sesion. Es reversible, y por eso puede correr sin aprobacion humana. Ademas es idempotente: llamarla dos veces por el mismo incidente no causa dano.",
                      "inputs": {
                        "method": "POST",
                        "uri": "https://graph.microsoft.com/v1.0/users/@{outputs('Obtener_la_cuenta_afectada')?['properties']?['aadUserId']}/revokeSignInSessions",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://graph.microsoft.com"
                        }
                      }
                    },
                    "Anotar_exito": {
                      "runAfter": { "Revocar_sesiones": ["Succeeded"] },
                      "type": "ApiConnection",
                      "inputs": {
                        "body": {
                          "incidentArmId": "@body('Microsoft_Sentinel_incident')?['object']?['id']",
                          "message": "<p><b>Playbook revoke-sessions-on-mfa-fatigue</b></p><p>Se revocaron las sesiones de <b>@{outputs('Obtener_la_cuenta_afectada')?['properties']?['friendlyName']}</b>.</p><p>La cuenta <b>NO</b> fue deshabilitada: revocar es reversible, deshabilitar no. Pasos siguientes para el analista: forzar cambio de contrasena, re-registrar el metodo de MFA, y revisar que hizo la sesion antes de la revocacion.</p>"
                        },
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                          }
                        },
                        "method": "post",
                        "path": "/Incidents/Comment"
                      }
                    },
                    "Anotar_fallo_de_revocacion": {
                      "runAfter": { "Revocar_sesiones": ["Failed", "TimedOut", "Skipped"] },
                      "type": "ApiConnection",
                      "description": "FALLAR RUIDOSAMENTE. Si la revocacion no ocurrio, el incidente TIENE que decirlo. Un playbook que falla en silencio es peor que no tener playbook: el analista cierra el incidente creyendo que la contencion ya se hizo.",
                      "inputs": {
                        "body": {
                          "incidentArmId": "@body('Microsoft_Sentinel_incident')?['object']?['id']",
                          "message": "<p><b>ATENCION — la revocacion de sesiones FALLO</b></p><p>El playbook intento revocar las sesiones de <b>@{outputs('Obtener_la_cuenta_afectada')?['properties']?['friendlyName']}</b> y no lo consiguio.</p><p><b>La contencion NO se hizo. Hay que revocar manualmente.</b></p>"
                        },
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                          }
                        },
                        "method": "post",
                        "path": "/Incidents/Comment"
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Escalar_sin_actuar": {
                        "runAfter": {},
                        "type": "ApiConnection",
                        "description": "La cuenta tiene roles de directorio. NO se actua automaticamente y se sube la severidad para que lo mire una persona.",
                        "inputs": {
                          "body": {
                            "incidentArmId": "@body('Microsoft_Sentinel_incident')?['object']?['id']",
                            "message": "<p><b>ESCALADO — no se actuo automaticamente</b></p><p>La cuenta <b>@{outputs('Obtener_la_cuenta_afectada')?['properties']?['friendlyName']}</b> tiene roles de directorio asignados. El playbook <b>NO</b> revoco sus sesiones a proposito: revocar la sesion de un administrador durante un incidente puede cortar la respuesta al incidente, y un atacante podria disparar esta deteccion contra un administrador justamente para lograr eso.</p><p><b>Requiere decision humana.</b></p>"
                          },
                          "host": {
                            "connection": {
                              "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                            }
                          },
                          "method": "post",
                          "path": "/Incidents/Comment"
                        }
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Anotar_que_no_habia_cuenta": {
                    "runAfter": {},
                    "type": "ApiConnection",
                    "description": "El incidente no traia una entidad Account utilizable. Se deja constancia en vez de terminar en silencio: un playbook que no hizo nada y no lo dice se lee como un playbook que funciono.",
                    "inputs": {
                      "body": {
                        "incidentArmId": "@body('Microsoft_Sentinel_incident')?['object']?['id']",
                        "message": "<p><b>Playbook revoke-sessions-on-mfa-fatigue</b></p><p>No se ejecuto ninguna accion: el incidente no incluye una entidad de tipo Account con identificador de Entra ID. Revisar el entityMappings de la regla que lo genero.</p>"
                      },
                      "host": {
                        "connection": {
                          "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                        }
                      },
                      "method": "post",
                      "path": "/Incidents/Comment"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "azuresentinel": {
                "connectionId": "[resourceId('Microsoft.Web/connections', variables('AzureSentinelConnectionName'))]",
                "connectionName": "[variables('AzureSentinelConnectionName')]",
                "connectionProperties": {
                  "authentication": { "type": "ManagedServiceIdentity" }
                },
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', resourceGroup().location, '/managedApis/azuresentinel')]"
              }
            }
          }
        }
      }
    }
  ]
}
