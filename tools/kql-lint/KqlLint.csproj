<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>kql-lint</AssemblyName>
    <RootNamespace>KqlLint</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- El parser REAL de Kusto que usa Microsoft. No es una heuristica nuestra:
         es la misma libreria que valida las consultas en Azure Data Explorer. -->
    <PackageReference Include="Microsoft.Azure.Kusto.Language" Version="11.*" />
  </ItemGroup>
</Project>
